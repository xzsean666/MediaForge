MEDIAFORGE_MODE=combined
MEDIAFORGE_HTTP_BIND=0.0.0.0:8080
MEDIAFORGE_PORT=8080

# Local Docker smoke tests can use filesystem storage.
# Production should set MEDIAFORGE_STORAGE_BACKEND=s3 and provide S3-compatible credentials.
MEDIAFORGE_STORAGE_BACKEND=filesystem
MEDIAFORGE_FILESYSTEM_STORAGE_ROOT=/var/lib/mediaforge/object-store

MEDIAFORGE_S3_ENDPOINT=
MEDIAFORGE_S3_REGION=auto
MEDIAFORGE_S3_BUCKET=mediaforge
MEDIAFORGE_S3_ACCESS_KEY_ID=
MEDIAFORGE_S3_SECRET_ACCESS_KEY=
MEDIAFORGE_S3_FORCE_PATH_STYLE=false

MEDIAFORGE_CDN_BASE_URL=http://localhost:8080/local-cdn
MEDIAFORGE_LINK_SIGNING_SECRET=development-only-change-me

# Authentication (disabled by default). When enabled, every endpoint except
# /health requires a valid HS256 JWT signed with MEDIAFORGE_JWT_SECRET. The
# server refuses to start if auth is enabled without a secret.
MEDIAFORGE_AUTH_ENABLED=false
MEDIAFORGE_JWT_SECRET=
MEDIAFORGE_AUTH_LEEWAY_SECONDS=30

# Upload size limit (enabled by default, 5 GiB). Set ENABLED=false to disable.
# Enforced at presign time (declared size) and completion (actual object size).
MEDIAFORGE_UPLOAD_LIMIT_ENABLED=true
MEDIAFORGE_MAX_UPLOAD_BYTES=5368709120
# Lifetime of the presigned PUT URL handed to clients.
MEDIAFORGE_PRESIGNED_UPLOAD_EXPIRY_SECONDS=3600

MEDIAFORGE_TEMP_DIR=/tmp/mediaforge
MEDIAFORGE_FFMPEG_PATH=ffmpeg
MEDIAFORGE_FFPROBE_PATH=ffprobe
MEDIAFORGE_FFMPEG_THREADS=1
MEDIAFORGE_FFMPEG_VIDEO_ACCELERATION=none
# Used only with docker-compose.gpu.yml. Accepts a GPU index such as 0, or a GPU UUID.
MEDIAFORGE_NVIDIA_DEVICE_ID=0
MEDIAFORGE_NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
MEDIAFORGE_WORKER_CONCURRENCY=1
MEDIAFORGE_WORKER_POLL_INTERVAL_SECONDS=5
# Reclaim tasks abandoned by a crashed worker after this many seconds.
MEDIAFORGE_TASK_LEASE_TIMEOUT_SECONDS=600
# Retry a failed task up to this many attempts before marking it failed.
MEDIAFORGE_TASK_MAX_ATTEMPTS=3
# Periodically delete original source files past their requested TTL.
MEDIAFORGE_SOURCE_REAPER_ENABLED=true
MEDIAFORGE_LOG_LEVEL=info
